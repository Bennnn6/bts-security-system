# =========================================================
# SMART BTS GATE SECURITY SYSTEM - ENVIRONMENT CONFIG TEMPLATE
# Salin file ini menjadi .env dan sesuaikan nilainya:
# cp .env.example .env
# =========================================================

# Secret key aplikasi Flask
SECRET_KEY=your_secret_key_here_change_for_production

# Database configuration
# Default: SQLite (instance/app.db)
DATABASE_URL=sqlite:///app.db
# Jika ingin beralih ke MySQL:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/bts_security

# Keamanan Pengenalan Wajah (0.45 = ketat, 0.52 = optimal, 0.60 = default)
FACE_MATCH_THRESHOLD=0.52

# Liveness Detection / Anti-Spoofing (True/False)
LIVENESS_DETECTION_ENABLED=False

# Durasi buka gerbang otomatis (detik)
GATE_OPEN_SECONDS=10

# Proteksi Brute-force OTP
OTP_MAX_FAILURES=3
OTP_LOCKOUT_MINUTES=5

# Sistem Tiket Kerja / Work Order (False = bebas masuk, True = wajib tiket aktif)
ENABLE_WORK_ORDER_CHECK=False

# Notifikasi Telegram Bot Alert
TELEGRAM_NOTIFICATIONS_ENABLED=False
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
