# =========================================================
# SMART BTS GATE SECURITY SYSTEM - ENVIRONMENT CONFIG TEMPLATE
# Salin file ini menjadi .env dan sesuaikan nilainya:
# cp .env.example .env
# =========================================================

# Secret key aplikasi Flask
APP_ENV=development
SECRET_KEY=replace_with_a_random_64_character_secret
SESSION_COOKIE_SECURE=False
FLASK_DEBUG=False

# Bootstrap admin: isi sementara dengan password unik (minimal 12 karakter),
# buka /setup_admin dari komputer server, lalu hapus nilai ini setelah setup.
INITIAL_ADMIN_PASSWORD=

# Database configuration
# Default: SQLite (instance/app.db)
DATABASE_URL=sqlite:///app.db
# Jika ingin beralih ke MySQL:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/bts_security

# Keamanan Pengenalan Wajah (0.45 = ketat, 0.52 = optimal, 0.60 = default)
FACE_MATCH_THRESHOLD=0.52

# Liveness Detection / Anti-Spoofing (True/False)
LIVENESS_DETECTION_ENABLED=True

# Durasi buka gerbang otomatis (detik)
GATE_OPEN_SECONDS=10

# Proteksi Brute-force OTP
OTP_MAX_FAILURES=3
OTP_LOCKOUT_MINUTES=5

# Wajib Face ID lalu TOTP sebelum gerbang dibuka.
STRICT_2FA_MODE=True

# Silent duress dinonaktifkan jika kosong. Aktifkan dengan PIN rahasia 6 digit.
DURESS_PIN=

# Token rahasia untuk perangkat sensor fisik, bukan browser kiosk.
GATE_SENSOR_TOKEN=

# Validasi lokasi untuk alur Face, OTP, dan tiket QR.
GEOFENCE_ENABLED=True
GEOFENCE_REQUIRE_COORDINATES=True
GEOFENCE_RADIUS_METERS=150

# Sistem Tiket Kerja / Work Order (False = bebas masuk, True = wajib tiket aktif)
ENABLE_WORK_ORDER_CHECK=False

# Notifikasi Telegram Bot Alert
TELEGRAM_NOTIFICATIONS_ENABLED=False
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
